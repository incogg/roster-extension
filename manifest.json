{
  "manifest_version": 3,
  "name": "Roster Extension",
  "version": "2.0",
  "description": "Replaces the Star ESS roster with a redesigned view and adds pick up / give away shift actions.",
  "icons": {
    "16": "icons/star-16.png",
    "32": "icons/star-32.png",
    "48": "icons/star-48.png",
    "128": "icons/star-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "roster-extension@local"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://cloud.umami.is/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "web_accessible_resources": [
    {
      "resources": ["injected.js", "star.svg"],
      "matches": ["https://vr.star.com.au/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://vr.star.com.au/syd/*"],
      "js": ["content.js", "roster.js"],
      "css": ["roster.css"],
      "run_at": "document_idle"
    }
  ]
}
